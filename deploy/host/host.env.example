# shellcheck shell=bash disable=SC2034
# The host env file: every setting bootstrap.sh and verify.sh read about one
# host. On the host it is /etc/hangar/host.env, root's, mode 0600; --env FILE
# names another. The real file lives with the operator, not in this
# repository: every value below is an example (documentation addresses,
# made-up serials), and none of them is any real host's.
#
#   sudo install -D -m 0600 -o root -g root host.env /etc/hangar/host.env
#
# Every value is explicit: the scripts never guess a disk or an interface.
# The bootstrap admin and the auth settings are not here: they live in
# /etc/hangar/local.env (docs/runbook/host-bootstrap.md).

# The uplink: its name as the installed OS calls it, and its permanent MAC,
# which the network step's netplan matches on.
HANGAR_UPLINK=eth0
HANGAR_UPLINK_MAC=02:00:00:00:00:01
# Optional: name makes the netplan match the uplink by HANGAR_UPLINK instead
# of by MAC, for a virtual link with no permanent MAC (the testbed's veth).
# Leave it unset on a real host; the default is mac.
#HANGAR_UPLINK_MATCH=name

# The host's one IPv4 (DHCP on the uplink); the guests' traffic leaves as it.
HANGAR_PUBLIC_IPV4=203.0.113.10

# The host's own IPv6 address in its routed /64, never the prefix's ::
# address (the network step moves the host off it), and the gateway, which
# may sit outside the /64 (it is routed on-link).
HANGAR_IPV6_ADDR=2001:db8:0:1::1/64
HANGAR_IPV6_GATEWAY=2001:db8:0:ff::ffff

# The two swap partitions the installer made, one per disk, by stable path;
# the swap-raid step mirrors them as md array HANGAR_SWAP_MD_NAME. Until the
# array exists, both must hold swap or the step refuses to wipe them.
HANGAR_SWAP_PARTS="/dev/disk/by-id/nvme-EXAMPLE_SERIAL_0001-part3 /dev/disk/by-id/nvme-EXAMPLE_SERIAL_0002-part3"
HANGAR_SWAP_MD_NAME=swap

# The ZFS pool the installer made, and the most the ARC may take, in bytes.
HANGAR_ZPOOL=hangar
HANGAR_ARC_MAX_BYTES=17179869184

# What the image cache and the VMs' directories may take, in whole GiB; the
# node keeps their sum back from root disks.
HANGAR_IMAGES_QUOTA=100G
HANGAR_VMS_QUOTA=600G

# Memory no VM may take, as a quantity: the ARC cap plus the host's own
# overhead.
HANGAR_RESERVED_MEMORY=20Gi

# How many tenants one person or service token may own, unless their User
# says otherwise (docs/decisions/tenancy-and-iam.md): one, the tenant signing
# up opens.
HANGAR_DEFAULT_MAX_OWNED_TENANTS=1

# The Node the agent reports as.
HANGAR_NODE_NAME=node-01

# Optional: the time zone the daily security upgrades run in, at 04:00
# (their lists are fetched at 03:30). A zone in /usr/share/zoneinfo; UTC
# when unset.
HANGAR_UPGRADES_TZ=UTC

# Optional: the users sshd lets in, with a key in ~/.ssh/authorized_keys,
# separated by spaces; ubuntu, the cloud image's user, when unset. The sshd
# step refuses a list none of whom has a key.
#HANGAR_SSH_USERS=ubuntu

# Optional: where the host is and what it is built of, as the machines on it
# report it in their placement (docs/decisions/machine-placement.md). Each
# is passed to hangar-node as its flag (--region, --site, --chassis,
# --memory, --network) only when set; at most 64 printable characters. The
# agent finds the CPU, the disks, the memory and the network ports itself;
# HANGAR_MEMORY and HANGAR_NETWORK override what it finds.
HANGAR_REGION=region-1
HANGAR_SITE=site-a
# A DNS-1123 label a client draws the machines' host with; another is drawn
# as a generic server.
HANGAR_CHASSIS=generic-1u-2x-u2
HANGAR_MEMORY="DDR4-3200 ECC"
HANGAR_NETWORK="2 × 10 GbE"
