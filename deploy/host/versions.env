# shellcheck shell=bash disable=SC2034
# Versions pinned for every host. Bump the version and the checksum together.

HANGAR_CH_VERSION=v53.0
HANGAR_CH_URL="https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/${HANGAR_CH_VERSION}/cloud-hypervisor-static"
HANGAR_CH_SHA256=448af3d4e59b22c2987f7df94c213ad40fb53a10d437e42b5ee6c4fce7c29ecc

# The firmware VirtualMachines boot their own kernel through, Cloud
# Hypervisor's EDK2 build (docs/decisions/vm-boot.md). Its releases publish
# no checksums: the sha256 is the file's as first fetched.
HANGAR_FW_VERSION=ch-97eeb7b09
HANGAR_FW_URL="https://github.com/cloud-hypervisor/edk2/releases/download/${HANGAR_FW_VERSION}/CLOUDHV.fd"
HANGAR_FW_SHA256=dc2fc8f0e43b96712d9fccc52a3a590769606412b3e1bc911d217addd3bef624

# The GitHub CLI, for `gh attestation verify` in hangar-fetch-release
# (deploy/host/fetch-release.sh), which runs it as /usr/local/bin/gh. Pinned
# like Cloud Hypervisor rather than taken from apt: Ubuntu 24.04's gh (2.45)
# predates fixes to the very checks it would make (2.102.0 stopped matching
# --signer-workflow as a prefix), and GitHub's apt repository keeps only its
# latest version, so a version pinned there stops installing as soon as the
# next one is out.
# The first sha256 is the tarball's, as in the release's checksums.txt; the
# second the gh binary's in it, which verify.sh checks on the host.
HANGAR_GH_VERSION=2.102.0
HANGAR_GH_URL="https://github.com/cli/cli/releases/download/v${HANGAR_GH_VERSION}/gh_${HANGAR_GH_VERSION}_linux_amd64.tar.gz"
HANGAR_GH_SHA256=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
HANGAR_GH_BIN_SHA256=7469124f706944133d6a169691dd1c6c3511b12e85878d255e044e2948df4c9b

HANGAR_PACKAGES="zfsutils-linux nftables mdadm iproute2 curl ca-certificates python3 python3-yaml openssl e2fsprogs qemu-utils unattended-upgrades tzdata"

# qemu-img (qemu-utils) comes from the distribution, kept current by
# unattended-upgrades like the other packages; this is the oldest the node
# agent's disk image driver runs (convert --target-is-zero, info JSON).
HANGAR_QEMU_IMG_MIN=8.2
