# shellcheck shell=bash disable=SC2034
# Versions pinned for every host. Bump the version and the checksum together.

HANGAR_CH_VERSION=v53.0
HANGAR_CH_URL="https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/${HANGAR_CH_VERSION}/cloud-hypervisor-static"
HANGAR_CH_SHA256=448af3d4e59b22c2987f7df94c213ad40fb53a10d437e42b5ee6c4fce7c29ecc

# The firmware VirtualMachines boot their own kernel through, Cloud
# Hypervisor's EDK2 build (docs/decisions/vm-boot.md). Its releases publish
# no checksums: the sha256 is the file's as first fetched.
HANGAR_FW_VERSION=ch-97eeb7b09
HANGAR_FW_URL="https://github.com/cloud-hypervisor/edk2/releases/download/${HANGAR_FW_VERSION}/CLOUDHV.fd"
HANGAR_FW_SHA256=dc2fc8f0e43b96712d9fccc52a3a590769606412b3e1bc911d217addd3bef624

# The GitHub CLI, for `gh attestation verify` in hangar-fetch-release
# (deploy/host/fetch-release.sh), which runs it as /usr/local/bin/gh. Pinned
# like Cloud Hypervisor rather than taken from apt: Ubuntu 24.04's gh (2.45)
# predates fixes to the very checks it would make (2.102.0 stopped matching
# --signer-workflow as a prefix), and GitHub's apt repository keeps only its
# latest version, so a version pinned there stops installing as soon as the
# next one is out.
# The first sha256 is the tarball's, as in the release's checksums.txt; the
# second the gh binary's in it, which verify.sh checks on the host.
HANGAR_GH_VERSION=2.102.0
HANGAR_GH_URL="https://github.com/cli/cli/releases/download/v${HANGAR_GH_VERSION}/gh_${HANGAR_GH_VERSION}_linux_amd64.tar.gz"
HANGAR_GH_SHA256=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
HANGAR_GH_BIN_SHA256=7469124f706944133d6a169691dd1c6c3511b12e85878d255e044e2948df4c9b

# The monitoring stack (docs/decisions/monitoring.md), installed by the
# monitoring step (deploy/host/steps/90-monitoring.sh). Pinned like the GitHub
# CLI, never from apt: the first sha256 is the tarball's, as in the
# release's sha256sums.txt; the others each binary's in it, which verify.sh
# checks on the host. Prometheus's tarball also holds promtool, which
# tools/promtool.sh runs from this same pin to check the alerting rules.
HANGAR_PROMETHEUS_VERSION=3.15.0
HANGAR_PROMETHEUS_URL="https://github.com/prometheus/prometheus/releases/download/v${HANGAR_PROMETHEUS_VERSION}/prometheus-${HANGAR_PROMETHEUS_VERSION}.linux-amd64.tar.gz"
HANGAR_PROMETHEUS_SHA256=2a542df32eac02ee17b9d844fb2aa1de00dafa5476579ba8a3ba862e9d572ea0
HANGAR_PROMETHEUS_BIN_SHA256=dac83d1d1007961de3b9ba624942c9af0c192ee3df262ac47ef390bcade71c65
HANGAR_PROMTOOL_BIN_SHA256=c736d55d3ccd959fe48329965fb5cb671d45585a9483954766448035100ff75c

# Its tarball also holds amtool, which tools/amtool.sh runs from this pin to
# check the Alertmanager configuration the monitoring step writes.
HANGAR_ALERTMANAGER_VERSION=0.34.1
HANGAR_ALERTMANAGER_URL="https://github.com/prometheus/alertmanager/releases/download/v${HANGAR_ALERTMANAGER_VERSION}/alertmanager-${HANGAR_ALERTMANAGER_VERSION}.linux-amd64.tar.gz"
HANGAR_ALERTMANAGER_SHA256=265b9d1e55ef0d5306a436018af6d2b686c2ce051f03d968f7464ecb1372a7e8
HANGAR_ALERTMANAGER_BIN_SHA256=154890307c382a186d4ddf9354cfa0cab08771f818aac1e647d0cf277ecef854
HANGAR_AMTOOL_BIN_SHA256=1153b0dbf2a672fd54f7da597901b776a3d4e0daaa5c38f3710efc51b8c3b4c8

HANGAR_NODE_EXPORTER_VERSION=1.12.1
HANGAR_NODE_EXPORTER_URL="https://github.com/prometheus/node_exporter/releases/download/v${HANGAR_NODE_EXPORTER_VERSION}/node_exporter-${HANGAR_NODE_EXPORTER_VERSION}.linux-amd64.tar.gz"
HANGAR_NODE_EXPORTER_SHA256=b51d8a76aa2a9156a55d501aca6276fae09e262259a5e4e831d2c2222f084e63
HANGAR_NODE_EXPORTER_BIN_SHA256=1108f7453ecfe4a72f131c73b69537c171840ad4f1713a2402328ad56cf12e09

HANGAR_SMARTCTL_EXPORTER_VERSION=0.15.0
HANGAR_SMARTCTL_EXPORTER_URL="https://github.com/prometheus-community/smartctl_exporter/releases/download/v${HANGAR_SMARTCTL_EXPORTER_VERSION}/smartctl_exporter-${HANGAR_SMARTCTL_EXPORTER_VERSION}.linux-amd64.tar.gz"
HANGAR_SMARTCTL_EXPORTER_SHA256=32ff269f2ca5708e2aa8209c715192efcc32f87bd575cae50a76d391a484976e
HANGAR_SMARTCTL_EXPORTER_BIN_SHA256=d936639bdcc370349d4c69f679dcfbcced52bad789d295753b09b421ff1413c2

# The HTTPS probe of the API and the console, and their certificates.
HANGAR_BLACKBOX_EXPORTER_VERSION=0.29.0
HANGAR_BLACKBOX_EXPORTER_URL="https://github.com/prometheus/blackbox_exporter/releases/download/v${HANGAR_BLACKBOX_EXPORTER_VERSION}/blackbox_exporter-${HANGAR_BLACKBOX_EXPORTER_VERSION}.linux-amd64.tar.gz"
HANGAR_BLACKBOX_EXPORTER_SHA256=5512929259bb6164f68ebe20ce433ec43b8609e3a79c95324f5020e931488fb4
HANGAR_BLACKBOX_EXPORTER_BIN_SHA256=3fcc2d41665e4ea80a5ee931b2532598e2378f5881e603a77112c7316552d42a

# The qemu-img the converter initramfs carries, from the Alpine packages
# guest/converter/converter.env pins, which a release builds it from: its
# build refuses another, and verify.sh checks the installed one says this
# (docs/runbook/converter.md). The host itself never runs it.
HANGAR_CONVERTER_QEMU_IMG=10.0.0-r1

# The swtpm a VM's vTPM runs, a bundle with its own loader and libraries
# from the Alpine packages deploy/swtpm/swtpm.env pins, at a path of
# Hangar's, never the distribution's /usr/bin/swtpm, whose AppArmor
# profile would attach; its build refuses another version.
HANGAR_SWTPM_VERSION=0.10.2-r0

HANGAR_PACKAGES="zfsutils-linux nftables mdadm iproute2 curl ca-certificates python3 python3-yaml openssl e2fsprogs qemu-utils unattended-upgrades tzdata smartmontools"

# qemu-img (qemu-utils) comes from the distribution, kept current by
# unattended-upgrades like the other packages; this is the oldest the node
# agent's disk image driver runs (convert --target-is-zero, info JSON).
HANGAR_QEMU_IMG_MIN=8.2
