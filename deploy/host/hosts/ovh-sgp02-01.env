# shellcheck shell=bash disable=SC2034
# OVH RISE-4 in SGP02 (service ns5029410.ip-15-235-221.net).

HANGAR_UPLINK=enp66s0f0
HANGAR_UPLINK_MAC=9c:6b:00:3f:77:d4
# The host's one IPv4 (DHCP on the uplink); the guests' traffic leaves as it.
HANGAR_PUBLIC_IPV4=15.235.221.177

# OVH routes the /64 on-link; the gateway sits outside it, in the /56.
HANGAR_IPV6_ADDR=2402:1f00:8001:27b1::1/64
HANGAR_IPV6_GATEWAY=2402:1f00:8001:27ff:ff:ff:ff:ff

# The installer creates one unmirrored swap partition per NVMe disk. Until the
# array exists, both must hold swap or the step refuses to wipe them.
HANGAR_SWAP_PARTS="/dev/disk/by-id/nvme-SAMSUNG_MZQL2960HCJR-00A07_S64FNE0T403010-part4 /dev/disk/by-id/nvme-SAMSUNG_MZQL2960HCJR-00A07_S64FNE0RC01810-part4"
HANGAR_SWAP_MD_NAME=swap

HANGAR_ZPOOL=hangar
HANGAR_ARC_MAX_BYTES=17179869184
# What the image cache and the VMs' directories may take, in whole GiB; the
# node keeps their sum back from root disks.
HANGAR_IMAGES_QUOTA=100G
HANGAR_VMS_QUOTA=20G

# The Node the agent reports as. The bootstrap admin is not here: it lives in
# /etc/hangar/local.env on the host (docs/runbook/host-bootstrap.md).
HANGAR_NODE_NAME=ovh-sgp02-01
