# shellcheck shell=bash disable=SC2034
# The Alpine packages whose swtpm a VM's vTPM runs, with every shared
# library it needs, the bundle deploy/swtpm/build.sh makes. The shape is
# guest/converter/converter.env's, under the prefix HANGAR_SWTPM: each line
# is REPO/NAME-VERSION SHA256, the sha256 of the .apk file as Alpine's
# mirror serves it. Bump them together, and resolve the dependencies again
# from swtpm's own NEEDED entries, not the package's D: line, which names
# the libraries of swtpm_setup and swtpm_cert too (gnutls, gmp, libtasn1).

HANGAR_SWTPM_ALPINE=v3.22
HANGAR_SWTPM_MIRROR=https://dl-cdn.alpinelinux.org/alpine
# The release that mirrors the converter's packages, most of which these
# are too: the build tries it first, then Alpine.
HANGAR_SWTPM_RELEASE=https://github.com/YukinaMochizuki/hangar/releases/download/converter-deps
HANGAR_SWTPM_PACKAGES="
community/json-glib-1.10.8-r0 33bfda1f7b70fc20db10e8f6ac8a0c80bfd3cd8e624618cf3175cfe968c68f32
community/libtpms-0.10.1-r0 63da0c24b312a2c34b05882a261d1a049f78ab48b06cc1cae1168544fa8bdd22
community/swtpm-0.10.2-r0 e8ba77d194b16232ad3dfe946ddbedff43420b15416d4b6fac5ce4b0296387e7
main/glib-2.84.4-r0 f9ec9e7d1f348fe2a87a124261f560909d1a4ac3020964c4ec372ff50f8ffad5
main/libblkid-2.41.6-r1 ab85cd837c906979c24e5a006a81789ae9715e6e913c421c71950bdf1450164c
main/libcrypto3-3.5.9-r0 3f5825ced5fde1c66a5376a3f6076b3c08538ad52d9ef23f069857e212d9175a
main/libeconf-0.6.3-r0 fe4fbf324f84f7c8b475cfc708c5505aa630bced7b5f6289bf5ca36d9b587829
main/libffi-3.4.8-r0 9a75cb9024693c1e52c3d8d7c9afb7c79e6e20f6c08df28effdb8dd816095083
main/libintl-0.24.1-r0 1e9900a63a851e790b28d201d5c11872a5ff74322fd998c06ac952c6a2ed1ce4
main/libmount-2.41.6-r1 722dfd3d977054b9b9af218ba89f980630e07d21122299a98dbcf617fdc3d015
main/libseccomp-2.6.1-r0 5ef97bb2cb4bde12a7cdcab7a0eca90745ddfba8c61e56719aed4cdbf43ca02e
main/musl-1.2.5-r13 359890bc7c4dc5fee7a85192de60a471c987e4664767288578beca60a44db2c8
main/pcre2-10.46-r1 e0e0e3c5f3b4a37a77799a7367bb40dd38596be55f56f3bc60f2cb4b584f842c
main/zlib-1.3.2-r1 af24e502645e2b392cae833856d776691ac21655362e5db69d7b89f147f76216
"
