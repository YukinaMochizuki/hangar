# shellcheck shell=bash disable=SC2034
# The Tailscale release whose tailscaled and tailscale CLI the tailscale
# disk carries, which a container joining a tailnet gets read-only
# (docs/decisions/container-tailscale.md). Bump the version and the
# checksum together, from Tailscale's published .sha256 of the archive
# (docs/runbook/guest-kernel.md, "Bump tailscale").

HANGAR_TAILSCALE_VERSION=1.104.2
HANGAR_TAILSCALE_URL="https://pkgs.tailscale.com/stable/tailscale_${HANGAR_TAILSCALE_VERSION}_amd64.tgz"
HANGAR_TAILSCALE_SHA256=512f613ed7d04fc7282f7dc5bd76aa105aae28168fbb9357eb749ebcbc29f0ae
