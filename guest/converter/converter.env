# shellcheck shell=bash disable=SC2034
# The Alpine packages whose qemu-img the converter initramfs carries, with
# every shared library it needs (docs/runbook/converter.md). Each line is
# REPO/NAME-VERSION SHA256, the sha256 of the .apk file as Alpine's mirror
# serves it. Bump them together, and resolve the dependencies again, as the
# runbook says.

HANGAR_CONVERTER_ALPINE=v3.22
HANGAR_CONVERTER_MIRROR=https://dl-cdn.alpinelinux.org/alpine
# This repository's release that mirrors the packages, which the build
# tries first: a package NAME-VERSION.apk is at this URL, a slash and its
# name. The converter-mirror workflow uploads what it lacks.
HANGAR_CONVERTER_RELEASE=https://github.com/YukinaMochizuki/hangar/releases/download/converter-deps
HANGAR_CONVERTER_PACKAGES="
community/qemu-img-10.0.0-r1 86e4706bda1d2328e3e8db6183a1682b8967fd9d11c7a580431e849f6bdb889b
main/glib-2.84.4-r0 f9ec9e7d1f348fe2a87a124261f560909d1a4ac3020964c4ec372ff50f8ffad5
main/gmp-6.3.0-r3 d3f987ae3836ac7774324bff443dd49d03b846209660729d0c30dfff5546e138
