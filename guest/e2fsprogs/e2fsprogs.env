# shellcheck shell=bash disable=SC2034
# The e2fsprogs whose mke2fs the initramfs carries, to format a container's
# blank volumes (docs/decisions/container-volumes.md). Bump the version and
# the checksum together, from the release's signed sha256sums.asc.

HANGAR_E2FSPROGS_VERSION=1.47.4
HANGAR_E2FSPROGS_URL="https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${HANGAR_E2FSPROGS_VERSION}/e2fsprogs-${HANGAR_E2FSPROGS_VERSION}.tar.xz"
HANGAR_E2FSPROGS_SHA256=fd5bf388cbdbe006a3d3b318d983b2948382440acc85a87f1e7d108653e8db0b
