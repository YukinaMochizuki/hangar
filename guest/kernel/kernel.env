# shellcheck shell=bash disable=SC2034
# The guest kernel every machine boots. Bump the version and the checksum
# together; docs/runbook/guest-kernel.md says how.

HANGAR_KERNEL_VERSION=6.18.55
HANGAR_KERNEL_URL="https://cdn.kernel.org/pub/linux/kernel/v${HANGAR_KERNEL_VERSION%%.*}.x/linux-${HANGAR_KERNEL_VERSION}.tar.xz"
HANGAR_KERNEL_SHA256=f410638061a165c12f42ab871d2f3fcd525515359b5faeee80969cff84524df9

# The base command line; the node appends the guest's own settings. The
# kernel runs /init from the platform initramfs, which mounts the root disk itself.
# `quiet` is not optional: every character printed to the serial console is a
# VM exit. `spectre_bhi=on` because the kernel leaves BHI unmitigated by
# default when it has no KVM (docs/decisions/guest-kernel.md).
HANGAR_KERNEL_CMDLINE="console=ttyS0 root=/dev/vda rw quiet spectre_bhi=on"
